{
  "name": "@vowora/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src drizzle.config.ts vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:drift": "node ../../scripts/drizzle-drift.mjs",
    "db:safety": "node ../../scripts/migration-safety.mjs drizzle",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@vowora/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
