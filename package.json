{
  "name": "vowora",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "typecheck": "tsc -p tsconfig.test.json && turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:tooling && pnpm test:boundaries && pnpm --filter @vowora/web test && pnpm test:e2e",
    "dev:marketing": "turbo run dev --filter=@vowora/marketing",
    "dev:web": "turbo run dev --filter=@vowora/web",
    "build:marketing": "turbo run build --filter=@vowora/marketing",
    "build:web": "turbo run build --filter=@vowora/web",
    "test:boundaries": "node --test scripts/workspace.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm --filter @vowora/web test:e2e && pnpm --filter @vowora/marketing test",
    "test:tooling": "node --test scripts/quality.test.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "@vowora/config": "workspace:*",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "@types/node": "26.6.5"
  }
}
