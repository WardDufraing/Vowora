{
  "extends": "@vowora/config/next.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "vitest.config.ts",
    "test/**/*.ts",
    "apps/**/*.unit.test.ts",
    "apps/**/*.component.test.tsx",
    "apps/**/tests/**/*.spec.ts",
    "apps/**/playwright.config.ts",
    "packages/**/*.unit.test.ts",
    "packages/**/*.integration.test.ts",
    "packages/**/vitest.integration.config.ts",
    "packages/**/drizzle.config.ts"
  ],
  "exclude": ["node_modules"]
}
