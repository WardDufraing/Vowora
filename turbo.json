{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "MARKETING_SITE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "VOWORA_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "MARKETING_SITE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "VOWORA_ENV"
      ],
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": [
        "DATABASE_MIGRATION_URL",
        "DATABASE_MIGRATION_TARGET",
        "DATABASE_MIGRATION_USERNAME",
        "DATABASE_MIGRATION_DATABASE"
      ]
    },
    "test:persistent-migrations": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_MIGRATION_URL", "DATABASE_MIGRATION_TARGET"]
    }
  }
}
